# NSO Adapter — runtime secrets (AppRole credentials only)
# Copy to .env and fill in real values.
# .env is gitignored — never commit it.
# All other configuration lives in config.yaml (also gitignored).

# HashiCorp Vault AppRole credentials
VAULT_ROLE_ID=<your-role-id>
VAULT_SECRET_ID=<your-secret-id>

# Optional: override config file path (default: config.yaml next to this file)
# CONFIG_FILE=/path/to/config.yaml

# Proxy bypass — list your NSO and Vault (and NetBox, for dev) hosts so the
# adapter reaches them directly instead of through the corporate proxy.
# NO_PROXY=<nso-host>,<vault-host>,localhost,127.0.0.1

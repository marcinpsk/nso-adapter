# NSO Adapter — environment settings (AppRole credentials + startup switches)
# Copy to .env and fill in real values.
# .env is gitignored — never commit it.
# The rest of the configuration lives in config.yaml (also gitignored).

# HashiCorp Vault AppRole credentials
VAULT_ROLE_ID=<your-role-id>
VAULT_SECRET_ID=<your-secret-id>

# Optional: override config file path (default: config.yaml next to this file)
# CONFIG_FILE=/path/to/config.yaml

# Optional: serve the API documentation routes. Off by default, when /docs, /redoc
# and /openapi.json answer 404. Set it to 1 to give every caller that can reach the
# adapter the OpenAPI schema and the two UI pages, with no authentication.
# ENABLE_API_DOCS=1

# Proxy bypass — list your NSO and Vault (and NetBox, for dev) hosts so the
# adapter reaches them directly instead of through the corporate proxy.
# NO_PROXY=<nso-host>,<vault-host>,localhost,127.0.0.1
